name: Sync Upstream Repository with Records

on:
  workflow_dispatch:  # 触发方式：手动
  schedule:
    - cron: '0 0 * * *'  # 每天午夜自动同步（可去除只用手动触发）

jobs:
  sync:
    runs-on: ubuntu-latest
    env:
      TARGET_BRANCH: main         # 目标分支
      UPSTREAM_BRANCH: main       # 上游分支（根据需求调整）
      SYNC_BRANCH: sync-upstream  # 同步的临时分支
      FINAL_BRANCH: 2256569       # 最终要推送的分支（你提到的“2256569”）
    steps:
    - name: Checkout target repository
      uses: actions/checkout@v3
      with:
        ref: ${{ env.TARGET_BRANCH }}
        token: ${{ secrets.GITHUB_TOKEN }}

    - name: Configure Git
      run: |
        git config user.name "github-actions"
        git config user.email "github-actions@github.com"

    - name: Add upstream remote
      run: |
        git remote add upstream https://github.com/a2256569/tv.git
        git fetch upstream

    - name: Check for upstream updates
      id: check_update
      run: |
        # 获取上游最新commit
        UPSTREAM_COMMIT=$(git rev-parse upstream/${{ env.UPSTREAM_BRANCH }})
        # 获取上次同步存储的commit（在仓库中存放）
        if [[ -f last_upstream_commit.txt ]]; then
          LAST_UPSTREAM_COMMIT=$(cat last_upstream_commit.txt)
        else
          LAST_UPSTREAM_COMMIT=""
        fi

        echo "Last upstream commit: $LAST_UPSTREAM_COMMIT"
        echo "Current upstream commit: $UPSTREAM_COMMIT"

        if [[ "$UPSTREAM_COMMIT" == "$LAST_UPSTREAM_COMMIT" ]]; then
          echo "No new updates from upstream."
          echo "::set-output name=update_needed::false"
        else
          echo "Updates found. Proceeding with sync."
          echo "::set-output name=update_needed::true"
          echo "$UPSTREAM_COMMIT" > last_upstream_commit.txt
        fi

    - name: Stop if no update
      if: steps.check_update.outputs.update_needed == 'false'
      run: echo "Upstream not updated. Exiting." && exit 0

    - name: Create or update sync branch from upstream
      run: |
        # 创建临时分支并拉取上游内容
        git checkout --detach upstream/${{ env.UPSTREAM_BRANCH }}
        git checkout -B ${{ env.SYNC_BRANCH }}

    - name: Merge sync branch into target branch
      run: |
        # 切回目标分支
        git checkout ${{ env.TARGET_BRANCH }}

        # 检查目标分支是否已有相应同步分支，如果没有，创建
        git fetch origin ${{ env.TARGET_BRANCH }}

        # 合并上游内容到目标分支，保留提交历史
        git merge --no-ff --log ${{ env.SYNC_BRANCH }} -m "Sync upstream commits from upstream/${{ env.UPSTREAM_BRANCH }}"

        # 推送同步结果到远端
        git push origin ${{ env.TARGET_BRANCH }}

    - name: Push the branch '2256569' with upstream history
      run: |
        # 如果要同步到特定分支（比如2256569）
        git checkout -B ${{ env.FINAL_BRANCH }}
        git push origin ${{ env.FINAL_BRANCH }} --force

    - name: Save last upstream commit
      if: success()
      run: |
        echo "$(git rev-parse upstream/${{ env.UPSTREAM_BRANCH }})" > last_upstream_commit.txt
